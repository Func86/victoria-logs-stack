{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "scheduling",
    "victoriaLogs",
    "vector",
    "vmauth",
    "cloudflared",
    "migration"
  ],
  "properties": {
    "scheduling": {
      "type": "object",
      "required": ["nodeSelector", "tolerations"],
      "properties": {
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"}
      }
    },
    "victoriaLogs": {
      "type": "object",
      "required": ["image", "retentionPeriod", "service", "storage"],
      "properties": {
        "image": {"type": "string", "minLength": 1},
        "retentionPeriod": {"type": "string", "minLength": 1},
        "extraArgs": {"type": "array", "items": {"type": "string"}},
        "service": {
          "type": "object",
          "required": ["port"],
          "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "storage": {
          "type": "object",
          "required": ["size", "storageClassName"],
          "properties": {
            "size": {"type": "string", "minLength": 1},
            "storageClassName": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "vector": {
      "type": "object",
      "required": ["enabled", "image", "config"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "config": {"type": "object"}
      }
    },
    "vmauth": {
      "type": "object",
      "required": ["enabled", "image", "httpAuthHeaders", "extraArgs", "config"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "httpAuthHeaders": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "extraArgs": {"type": "array", "items": {"type": "string"}},
        "config": {"type": "object"}
      }
    },
    "cloudflared": {
      "type": "object",
      "required": ["enabled", "image", "tokenSecretName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "tokenSecretName": {"type": "string", "minLength": 1}
      }
    },
    "migration": {
      "type": "object",
      "required": ["nodePort", "helper"],
      "properties": {
        "nodePort": {
          "type": "object",
          "required": ["enabled", "port"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 30000, "maximum": 32767}
          }
        },
        "helper": {
          "type": "object",
          "required": ["enabled", "image", "claimName"],
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"type": "string", "minLength": 1},
            "claimName": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "vector": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "vector": {
            "properties": {"config": {"minProperties": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "vmauth": {
            "properties": {"enabled": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "vmauth": {
            "properties": {
              "image": {"minLength": 1},
              "config": {"minProperties": 1}
            }
          }
        }
      }
    }
  ]
}
